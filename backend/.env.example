# Copy this file to .env for local development. Never commit real credentials.
# Render supplies PORT automatically. Do not set it unless required by your host.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Neon production connections normally require TLS verification.
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
MFA_ENCRYPTION_KEY=replace-with-a-third-random-32-plus-character-secret

# Use your exact frontend URL, including https:// and without a trailing slash.
FRONTEND_URL=https://affiliation.veggieradiance.com
CORS_ORIGIN=https://affiliation.veggieradiance.com
# Public website where referral visitors should land.
STOREFRONT_URL=https://veggieradiance.com/
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
STOREFRONT_API_KEY=replace-with-a-random-32-plus-character-storefront-key
AFFILIATE_DISCOUNT_PERCENT=10
# Configure a real provider before enabling outbound notifications.
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=notifications@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
